{
  "name": "@frontal/ts-linter",
  "version": "0.1.0",
  "description": "Opinionated TypeScript linter powered by Biome with preset rulesets and watch mode",
  "bin": {
    "ts-linter": "./dist/main.js"
  },
  "type": "module",
  "packageManager": "bun@1.1.0",
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "files": [
    "dist",
    "scripts",
    "rulesets",
    "references",
    "README.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "start": "node ./dist/main.js",
    "check": "node ./dist/main.js check",
    "fix": "node ./dist/main.js fix",
    "format": "node ./dist/main.js format",
    "watch": "node ./dist/main.js watch",
    "type-check": "tsc --noEmit",
    "dev": "bun run scripts/main.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish",
    "prepare": "husky"
  },
  "keywords": [
    "linter",
    "typescript",
    "biome",
    "formatter"
  ],
  "author": "Frontal Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/ts-linter"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^14.0.2",
    "consola": "^3.4.2",
    "picocolors": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.0.10",
    "bun-types": "^1.3.7",
    "husky": "^9.1.7",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=1.8.0"
  }
}